# Polymarket Configuration
PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# API Keys
CLAUDE_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Alerts: Telegram (see README "تنبيهات تيليجرام")
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# Optional alert settings
# ALERT_COOLDOWN=3600    # seconds before re-alerting the same position
# STARTUP_ALERT=1        # 0 to skip the "monitor started" message
# ALERT_TZ=Asia/Riyadh   # time zone shown in alerts

# Selling from Telegram (see README "زر البيع في تيليجرام")
# Use a separate Polymarket account holding only a small amount.
# TRADING_WALLET=bot_account_polymarket_wallet_address
# TRADING_PRIVATE_KEY=bot_account_metamask_private_key
# TRADING_ENABLED=1      # show sell buttons (default off)
# TRADING_DRY_RUN=0      # place real orders (default 1: simulate only)

# Position size alert: one event above this share of your capital (cash + positions)
# EXPOSURE_ALERT_PCT=5   # percent; 0 turns it off

# Paper trading on Bitcoin markets, no money (see README "التداول على الورق")
# PAPER_TRADING=0        # turn it off (default on when Telegram is configured)
# PAPER_STAKE=10         # virtual dollars per paper trade
# PAPER_MIN_EDGE=0.05    # minimum edge after fees (0.05 = 5 points)
# PAPER_LEDGER_FILE=paper_trades.json  # local file instead of the pinned Telegram file

# Flask Configuration
FLASK_ENV=development
PORT=5000

# Optional: Logging Level
LOG_LEVEL=INFO
