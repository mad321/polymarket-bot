# Polymarket Configuration
PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# API Keys
CLAUDE_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Alerts: Telegram (see README "تنبيهات تيليجرام")
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# Optional alert settings
# ALERT_COOLDOWN=3600    # seconds before re-alerting the same position
# STARTUP_ALERT=1        # 0 to skip the "monitor started" message
# ALERT_TZ=Asia/Riyadh   # time zone shown in alerts

# Flask Configuration
FLASK_ENV=development
PORT=5000

# Optional: Logging Level
LOG_LEVEL=INFO
